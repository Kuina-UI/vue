{
  "name": "@kuina-ui/vue",
  "version": "0.0.0",
  "description": "Free, open-source Vue component library built with Tailwind CSS v4, in light and dark themes",
  "keywords": [
    "kuina-ui",
    "vue",
    "nuxt",
    "ui-kit",
    "components",
    "tailwindcss",
    "tailwindcss-v4",
    "dark-mode"
  ],
  "homepage": "https://github.com/Kuina-UI/vue#readme",
  "bugs": {
    "url": "https://github.com/Kuina-UI/vue/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kuina-UI/vue.git"
  },
  "license": "MIT",
  "author": "Kuina",
  "type": "module",
  "files": [
    "dist",
    "src/index.css",
    "src/shared/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "style": "./src/index.css",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "tailwind-variants": "^4.0.2"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vue": "^3.5.46",
    "vue-tsc": "^3.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
